<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_sheet_dialog_konfirmasi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_sheet_close"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="@dimen/spacer_small"
                android:layout_marginStart="@dimen/spacer_small"
                android:layout_gravity="start"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/todo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_sheet_icon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_information"
                    android:contentDescription="@string/todo" />

                <TextView
                    android:id="@+id/view_bottom_tittle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloobhaijan"
                    android:gravity="end"
                    android:layout_marginStart="10dp"
                    android:hint="Tittle"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="25sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="5dp"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/view_bottom_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacer_small"
                    android:fontFamily="@font/baloobhai_bold"
                    android:gravity="center_vertical|center_horizontal"
                    android:hint="Message"
                    android:textColor="@color/black_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:padding="@dimen/margin_10"
                android:layout_marginTop="15dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bottom_action_negatif"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:hint="Kembali"
                    android:textColor="@color/colorCancel"
                    android:fontFamily="@font/baloobhai_medium"
                    android:layout_marginEnd="@dimen/margin_5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bottom_action_positif"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:hint="Konfirmasi"
                    android:textColor="@color/colorPrimaryDark"
                    android:fontFamily="@font/baloobhai_medium"
                    android:layout_marginStart="@dimen/margin_5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>