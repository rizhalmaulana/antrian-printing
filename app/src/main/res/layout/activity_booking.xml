<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.BookingActivity">

    <RelativeLayout
        android:id="@+id/rl_toolbar_booking"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_50"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/lr_back_booking"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="@dimen/margin_15"
                android:contentDescription="@string/todo"
                app:srcCompat="@drawable/ic_back_arrow" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/margin_20"
            android:layout_toEndOf="@id/lr_back_booking"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title_booking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloobhaijan"
                android:gravity="start"
                android:text="@string/booking_pesanan"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/text_normal" />
        </LinearLayout>

    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_20"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_toolbar_booking">

        <LinearLayout
            android:id="@+id/linear_board_jam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloobhai_medium"
                    android:gravity="center_vertical|center_horizontal"
                    android:text="@string/jam_booking"
                    android:textColor="@color/black_main"
                    android:textSize="@dimen/text_normal" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_10"
                        app:boxCornerRadiusBottomEnd="@dimen/margin_15"
                        app:boxCornerRadiusBottomStart="@dimen/margin_15"
                        app:boxCornerRadiusTopEnd="@dimen/margin_15"
                        app:boxCornerRadiusTopStart="@dimen/margin_15">

                        <AutoCompleteTextView
                            android:id="@+id/et_pilih_jam_booking"
                            android:layout_width="150dp"
                            android:layout_height="50dp"
                            android:ems="16"
                            android:fontFamily="@font/baloobhai_medium"
                            android:inputType="none"
                            android:hint="@string/jam_antrian"
                            android:textColor="@color/black_main"
                            android:textSize="@dimen/text_xNormal"
                            tools:ignore="LabelFor" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10"
                        app:boxCornerRadiusBottomEnd="@dimen/margin_15"
                        app:boxCornerRadiusBottomStart="@dimen/margin_15"
                        app:boxCornerRadiusTopEnd="@dimen/margin_15"
                        app:boxCornerRadiusTopStart="@dimen/margin_15">

                        <AutoCompleteTextView
                            android:id="@+id/et_pilih_jam_selesai"
                            android:layout_width="150dp"
                            android:layout_height="50dp"
                            android:ems="16"
                            android:fontFamily="@font/baloobhai_medium"
                            android:inputType="none"
                            android:hint="@string/jam_selesai"
                            android:textColor="@color/black_main"
                            android:textSize="@dimen/text_xNormal"
                            tools:ignore="LabelFor" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_30"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusBottomEnd="@dimen/margin_15"
            app:boxCornerRadiusBottomStart="@dimen/margin_15"
            app:boxCornerRadiusTopEnd="@dimen/margin_15"
            app:boxCornerRadiusTopStart="@dimen/margin_15">

            <AutoCompleteTextView
                android:id="@+id/et_pilih_designer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:ems="16"
                android:fontFamily="@font/baloobhai_medium"
                android:inputType="none"
                android:hint="@string/pilih_designer"
                android:textColor="@color/black_main"
                android:textSize="@dimen/text_xNormal"
                tools:ignore="LabelFor" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10"
            app:boxCornerRadiusBottomEnd="@dimen/margin_15"
            app:boxCornerRadiusBottomStart="@dimen/margin_15"
            app:boxCornerRadiusTopEnd="@dimen/margin_15"
            app:boxCornerRadiusTopStart="@dimen/margin_15">

            <AutoCompleteTextView
                android:id="@+id/et_pilih_pelayanan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:ems="16"
                android:fontFamily="@font/baloobhai_medium"
                android:inputType="none"
                android:hint="@string/pilih_pelayanan"
                android:textColor="@color/black_main"
                android:textSize="@dimen/text_xNormal"
                tools:ignore="LabelFor" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
            android:id="@+id/et_input_tanggal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/margin_10"
            android:fontFamily="@font/baloobhai_medium"
            android:hint="@string/tanggal_pesanan"
            android:textColor="@color/black_main"
            android:textAlignment="center"
            android:textSize="@dimen/text_xNormal"
            app:icon="@drawable/ic_calendar" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10"
            android:hint="@string/no_handphone_whatsapp"
            app:boxCornerRadiusBottomEnd="@dimen/margin_15"
            app:boxCornerRadiusBottomStart="@dimen/margin_15"
            app:boxCornerRadiusTopEnd="@dimen/margin_15"
            app:boxCornerRadiusTopStart="@dimen/margin_15"
            app:endIconMode="clear_text"
            app:hintAnimationEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_no_handphone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:fontFamily="@font/baloobhai_medium"
                android:inputType="number"
                android:textColor="@color/black_main"
                android:textSize="@dimen/text_xNormal" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btn_ketersediaan_booking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_30"
        android:background="@drawable/button_save"
        android:fontFamily="@font/baloobhai_bold"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/cek_ketersediaan"
        android:textColor="@color/white"
        android:textSize="@dimen/text_xNormal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>